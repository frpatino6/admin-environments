# Slack webhooks are now configured per-team in the database.
# Use PATCH /api/teams/:team/slack-webhook to set each team's webhook URL.

# ── QA requests ──────────────────────────────────────────────────────────
# The QA feature needs zero additional Slack App configuration: no bot token,
# no Interactivity/Signing Secret. Both action buttons ("Iniciar QA" and
# "Rechazar") are plain url-type Block Kit buttons that open a confirmation
# page in the deployed frontend; outbound messages reuse each team's existing
# Incoming Webhook (Team.slackWebhookUrl).
# Base URL of the deployed frontend, used to build the "Iniciar QA" and
# "Rechazar" link buttons in Slack (${FRONTEND_BASE_URL}/qa/requests/:id/start
# and .../reject).
FRONTEND_BASE_URL=http://localhost:4200
# Optional. If set, Jira ticket keys are rendered as links to ${JIRA_BASE_URL}/browse/:key
# (pure string concatenation — no Jira API call is ever made).
JIRA_BASE_URL=
# How long a request can stay 'pending' before a reminder is re-sent to the same reviewer.
QA_REMINDER_INTERVAL_HOURS=4
# How often the background job checks for overdue 'pending' requests.
QA_ESCALATION_CHECK_INTERVAL_MIN=15
# Business-hours window in which reminders may be sent (Monday-Friday 09:00-18:00
# by default). Outside it the job does not even query: no reminder is sent, and
# nothing is queued or deferred — a request that goes stale at 22:00 on Friday
# simply gets no reminder that weekend. These only gate the *reminder*; the
# initial assignment, start, reject, completed and changes-addressed
# notifications are always sent.
# IANA timezone the window is expressed in. Default: the server's own zone.
# CHANGE THIS to your team's real zone — if it is wrong the whole window shifts
# (a wrong zone can mean reminders never send, or send at 3am).
QA_REMINDER_TIMEZONE=America/Bogota
# Start hour (inclusive) and end hour (EXCLUSIVE) in local time: 09:00-18:00
# means the last reminder of the day goes out at 17:59.
QA_REMINDER_START_HOUR=9
QA_REMINDER_END_HOUR=18
# Days the window opens on, as ISO weekday numbers (1=lunes … 7=domingo),
# comma-separated. Invalid values are ignored (with a warning) and fall back to
# the Monday-Friday default.
QA_REMINDER_WEEKDAYS=1,2,3,4,5
