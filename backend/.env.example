MONGODB_URI=mongodb+srv://frpatino6Coffe:s4ntiago@mycoffecluster.yerjpro.mongodb.net/environment-algo
DNS_SERVERS=8.8.8.8,1.1.1.1
PORT=3000
# Slack webhooks are now configured per-team in the database.
# Use PATCH /api/teams/:team/slack-webhook to set each team's webhook URL.

# ── QA requests ──────────────────────────────────────────────────────────
# Slack Interactivity signing secret (Slack app > Basic Information > Signing Secret).
# Used only to verify inbound POSTs to /api/qa/slack/interactions (the "Iniciar QA"
# button). No Slack bot token is used anywhere — outbound messages reuse each
# team's existing Incoming Webhook (Team.slackWebhookUrl).
QA_SLACK_SIGNING_SECRET=
# Base URL of the deployed frontend, used to build the "Rechazar" link button
# in Slack (${FRONTEND_BASE_URL}/qa/requests/:id/reject).
FRONTEND_BASE_URL=http://localhost:4200
# Optional. If set, Jira ticket keys are rendered as links to ${JIRA_BASE_URL}/browse/:key
# (pure string concatenation — no Jira API call is ever made).
JIRA_BASE_URL=
# How long a request can stay 'pending' before a reminder is re-sent to the same reviewer.
QA_REMINDER_INTERVAL_HOURS=4
# How often the background job checks for overdue 'pending' requests.
QA_ESCALATION_CHECK_INTERVAL_MIN=15
